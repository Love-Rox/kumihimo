{
  "name": "kumihimo-vscode",
  "displayName": "kumihimo — AV signal flow diagrams",
  "version": "0.7.1",
  "private": true,
  "description": "%extension.description%",
  "categories": [
    "Linters",
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "av",
    "diagram",
    "signal-flow",
    "wiring",
    "系統図"
  ],
  "homepage": "https://kumihimo.love-rox.cc",
  "bugs": {
    "url": "https://github.com/Love-Rox/kumihimo/issues"
  },
  "license": "MIT",
  "author": "SASAGAWA Kiyoshi <dev@love-rox.cc>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Love-Rox/kumihimo.git",
    "directory": "packages/vscode"
  },
  "publisher": "love-rox",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "notices": "node scripts/build-notices.mjs",
    "package": "pnpm build && pnpm exec vsce package --no-dependencies",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@love-rox/kumihimo-core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.1",
    "ovsx": "^1.0.2"
  },
  "l10n": "./l10n",
  "contributes": {
    "languages": [
      {
        "id": "kumihimo",
        "aliases": [
          "kumihimo",
          "系統図"
        ],
        "extensions": [
          ".khm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kumihimo",
        "scopeName": "source.kumihimo",
        "path": "./syntaxes/kumihimo.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "kumihimo.showPreview",
        "title": "%command.showPreview%",
        "icon": "$(open-preview)"
      },
      {
        "command": "kumihimo.exportSvg",
        "title": "%command.exportSvg%",
        "category": "kumihimo"
      },
      {
        "command": "kumihimo.exportPng",
        "title": "%command.exportPng%",
        "category": "kumihimo"
      },
      {
        "command": "kumihimo.exportMarkdown",
        "title": "%command.exportMarkdown%",
        "category": "kumihimo"
      },
      {
        "command": "kumihimo.print",
        "title": "%command.print%",
        "category": "kumihimo"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "kumihimo.showPreview",
          "when": "editorLangId == kumihimo",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "kumihimo.showPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == kumihimo"
      }
    ],
    "configuration": {
      "title": "kumihimo",
      "properties": {
        "kumihimo.preview.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark",
            "mono",
            "blueprint"
          ],
          "default": "auto",
          "markdownDescription": "%config.preview.theme%"
        },
        "kumihimo.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.diagnostics.enabled%"
        },
        "kumihimo.diagnostics.delay": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "markdownDescription": "%config.diagnostics.delay%"
        },
        "kumihimo.preview.delay": {
          "type": "number",
          "default": 600,
          "minimum": 0,
          "description": "%config.preview.delay%"
        },
        "kumihimo.format.align": {
          "type": "boolean",
          "default": true,
          "description": "%config.format.align%"
        }
      }
    },
    "snippets": [
      {
        "language": "kumihimo",
        "path": "./snippets/kumihimo.json"
      }
    ]
  },
  "activationEvents": [],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#161b22",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  }
}
