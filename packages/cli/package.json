{
  "name": "@love-rox/kumihimo-cli",
  "version": "0.11.0",
  "description": "Command line interface for kumihimo AV signal flow diagrams (系統図)",
  "keywords": [
    "av",
    "cli",
    "diagram",
    "signal-flow",
    "svg",
    "wiring",
    "系統図"
  ],
  "homepage": "https://github.com/Love-Rox/kumihimo#readme",
  "bugs": {
    "url": "https://github.com/Love-Rox/kumihimo/issues"
  },
  "license": "MIT",
  "author": "SASAGAWA Kiyoshi <dev@love-rox.cc>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Love-Rox/kumihimo.git",
    "directory": "packages/cli"
  },
  "bin": {
    "khm": "./dist/cli.js",
    "kumihimo": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
