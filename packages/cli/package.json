    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run && pnpm build && node scripts/smoke-mpe.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@love-rox/kumihimo-core": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2"
  }
}
